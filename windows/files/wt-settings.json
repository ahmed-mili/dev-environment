{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions":
    [
        {
            "command": { "action": "sendInput", "input": "/login\r\r" },
            "id": "User.claudeLogin"
        },
        {
            "command": { "action": "sendInput", "input": "/resume\r" },
            "id": "User.claudeResume"
        }
    ],
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "disabledProfileSources":
    [
        "Windows.Terminal.Wsl"
    ],
    "keybindings":
    [
        { "id": "Terminal.CopyToClipboard",     "keys": "ctrl+c" },
        { "id": "Terminal.PasteFromClipboard",  "keys": "ctrl+v" },
        { "id": "Terminal.DuplicatePaneAuto",   "keys": "alt+shift+d" },
        { "id": "User.claudeLogin",             "keys": "alt+l" },
        { "id": "User.claudeResume",            "keys": "alt+r" }
    ],
    "newTabMenu":
    [
        { "type": "remainingProfiles" }
    ],
