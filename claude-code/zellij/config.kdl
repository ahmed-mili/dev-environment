// Zellij — config partagée (projets WSL & vaults Windows).
// Cf. docs/superpowers/plans/2026-06-02-zellij-everywhere.md
//
// Zellij fusionne ce fichier avec ses défauts : on ne met QUE les overrides.
// Déploiement :
//   WSL     -> ~/.config/zellij/config.kdl
//   Windows -> %APPDATA%\zellij\config\config.kdl  (retirer copy_command, cf. note)

theme "tokyo-night"          // proche de ton thème tmux Tokyo Night
mouse_mode true              // scroll molette + clic panes/tabs
scroll_buffer_size 50000     // gros scrollback (comme ton history-limit tmux)
pane_frames false            // épure, comme ton tmux minimaliste

// copy_on_select : true par DÉFAUT chez Zellij -> la copie-à-la-sélection que tu aimes.
// Copie : OSC52 par défaut (validé au POC, marche via SSH/tél) -> PAS de copy_command,
//   sinon Zellij copierait en local au lieu de transmettre au terminal client (le tél).
// On garde la barre de hints Zellij (tu l'aimes) -> pas de simplified_ui.
