// Zellij — config Linux/Termux (historique, pour compatibilité tierce).
// Cf. docs/superpowers/plans/2026-06-02-zellij-everywhere.md
//
// Zellij fusionne ce fichier avec ses défauts : on ne met QUE les overrides.
// Déploiement :
//   Linux/Termux -> ~/.config/zellij/config.kdl
//   Windows      -> %APPDATA%\zellij\config\config.kdl  (utiliser config-windows.kdl à la place)

// Linux/Termux : gruvbox adouci (custom, plus doux que gruvbox-dark built-in).
// Windows   : remplacer par theme "night-owl" (bleu ≈ console PowerShell).
theme "gruvbox-material"
mouse_mode true              // scroll molette + clic panes/tabs
scroll_buffer_size 50000     // gros scrollback (comme ton history-limit tmux)
pane_frames false            // épure, comme ton tmux minimaliste
session_serialization false  // pas de résurrection au reboot → jamais d'écran "Waiting to run"
on_force_close "detach"      // perte SSH/Termux brutale = detach, pas kill/reset du shell

// Force le truecolor (24-bit) dans toutes les panes : Claude Code lit COLORTERM pour
// décider du mode couleur. Zellij ne propage pas automatiquement cette variable du
// terminal parent (ssh -tt / mosh / Termux) → sans ça, Claude se rabat à 256-color.
env {
    COLORTERM "truecolor"
}

// copy_on_select : true par DÉFAUT chez Zellij -> la copie-à-la-sélection que tu aimes.
// Copie : OSC52 par défaut (validé au POC, marche via SSH/tél) -> PAS de copy_command,
//   sinon Zellij copierait en local au lieu de transmettre au terminal client (le tél).
// On garde la barre de hints Zellij (tu l'aimes) -> pas de simplified_ui.

// Thème custom : gruvbox-material = gruvbox désaturé/harmonisé (colorimétrie plus douce que gruvbox-dark built-in).
themes {
    gruvbox-material {
        fg "#d4be98"
        bg "#282828"
        black "#3c3836"
        red "#ea6962"
        green "#a9b665"
        yellow "#d8a657"
        blue "#7daea3"
        magenta "#d3869b"
        cyan "#89b482"
        white "#d4be98"
        orange "#e78a4e"
    }
}

// F2 = sessionizer universel (projets Linux + vaults Windows).
// Ctrl+Y = Ollama model launcher (menu dédié, pas une session Zellij).
keybinds {
    shared_except "locked" {
        bind "F2" { Run "bash" "-lc" "$HOME/dev/dev-environment/claude-code/tmux-sessionizer.sh"; }
        bind "Ctrl y" { Run "bash" "-lc" "$HOME/dev/dev-environment/claude-code/ollama-launcher.sh"; }
    }
}
