// Zellij -- config Windows natif (vaults & pwsh). Source versionnee : claude-code/zellij/config-windows.kdl ; deploiement -> %APPDATA%\Zellij\config\config.kdl
// Fusionne avec les defauts Zellij : on ne met QUE les overrides.

// Theme natif : night-owl (bleu ≈ console PowerShell).
theme "night-owl"
mouse_mode true
scroll_buffer_size 50000
pane_frames false
session_serialization false
on_force_close "detach"

// Truecolor pour Claude Code (il lit COLORTERM).
env {
    COLORTERM "truecolor"
}

// Shell par defaut : pwsh (resolu via PATH).
// Si Zellij ne le trouve pas, remplacer par le chemin absolu en backslashes
// vers C:\Users\<user>\AppData\Local\Microsoft\WindowsApps\pwsh.exe
default_shell "pwsh"

// F2 = sessionizer natif (pane flottant ; les ouvertures partent en onglets wt.exe,
// un `zellij attach` imbrique etant interdit). Esc/choix -> le pane se ferme seul.
// Ctrl+Y = Ollama Claude natif. Le profil pwsh reste charge pour que le wrapper
// ollama() demarre aussi img-clip-watcher.ps1 dans la bonne window station.
keybinds {
    shared_except "locked" {
        bind "F2" {
            Run "pwsh" "-NoProfile" "-ExecutionPolicy" "Bypass" "-Command" "& (Join-Path $env:USERPROFILE '.local\\bin\\sessionizer.ps1')" {
                floating true
                close_on_exit true
            }
        }
        bind "Ctrl y" { Run "pwsh" "-NoLogo" "-NoExit" "-Command" "ollama launch claude --dangerously-skip-permissions --verbose --debug"; }
    }
}
