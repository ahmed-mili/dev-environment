#!/data/data/com.termux/files/usr/bin/bash
# watcher-toggle — notif persistante Termux:API a 2 boutons pour piloter les flux
# image (captures + photos) SANS taper de commande.
#
# Source de verite des FLUX = les MEMES flags fichiers que le watcher / les alias photos-on/off :
#   ~/.screenshot-watcher.on      -> flux CAPTURES (dcim/Screenshots)
#   ~/.screenshot-watcher.photos  -> flux PHOTOS   (dcim/Camera)
# Le screenshot-watcher relit ces flags a chaque tour de boucle (0.5s) -> un tap prend
# effet quasi immediatement sans redemarrer le watcher.
#
# Source de verite du SERVICE = processus vivants. Les flags peuvent rester "on"
# apres un force-stop Android ; dans ce cas la notif DOIT dire offline, pas faire
# croire que le pipeline images tourne encore.
#
# Sous-commandes :
#   watcher-toggle show     -> (re)poste la notif selon l'etat courant des flags
#   watcher-toggle restore  -> reposte apres suppression manuelle de la notif
#   watcher-toggle photos   -> bascule le flag PHOTOS puis show
#   watcher-toggle shots    -> bascule le flag CAPTURES puis show
#
# Les boutons de la notif rappellent ce script en CHEMIN ABSOLU, via un bash lui aussi
# en CHEMIN ABSOLU ($BASH_BIN) : l'action s'execute dans un env PATH minimal (comme
# Termux:Boot, sans termux-exec) ou un `bash` nu ne serait pas forcement resolu ->
# aucune resolution relative possible. cf. reference_termux-boot-shebang et
# reference_wsl-task-scheduler-path (meme piege : forcer les binaires en dur).
#
# Persistance : --ongoing + --on-delete. HyperOS peut quand meme laisser disparaitre
# une notif "ongoing" dans certains gestes/groupes ; --on-delete rappelle `restore`,
# qui attend un court instant puis reposte. La notif est LE point de controle, elle
# ne doit jamais disparaitre par accident. Re-postee aussi a l'install et a chaque
# boot (cf. boot-screenshot-watcher). --priority low + --alert-once : silencieuse.
#
# Channel dedie : la notif est postee sur un channel Termux:API a part
# ("watcher-control"), cree a la volee (best-effort). Effet : elle apparait comme une
# CATEGORIE distincte dans Reglages HyperOS > Apps > Termux:API > Notifications,
# separee des notifs d'image (channel watcher-images d'img2clip). L'user
# peut la passer en silencieux cote HyperOS pour la faire descendre en bas du volet.
# Repli sans --channel si la creation echoue (cf show) -> aucune notif perdue.
#
# Dependance : app Termux:API + package termux-api. Si termux-notification est absent,
# `show` est un no-op silencieux MAIS les bascules de flag s'appliquent quand meme
# (les flags restent pilotables en CLI via photos-on/off).

set -uo pipefail

SELF="/data/data/com.termux/files/home/bin/watcher-toggle"
BASH_BIN="/data/data/com.termux/files/usr/bin/bash"
ON_FLAG="$HOME/.screenshot-watcher.on"
PHOTOS_FLAG="$HOME/.screenshot-watcher.photos"
BOOT_WATCHER="$HOME/.termux/boot/screenshot-watcher"
RUNTIME_WATCHER="$HOME/bin/screenshot-watcher"
NOTIF_ID="watcher-toggle"
CHANNEL_ID="watcher-control"
GROUP_ID="watcher-control"
RESTORE_DELAY="0"
# Nom SANS espace : termux-notification-channel expanse $ARGS NON quote -> un nom
# avec espace est tronque a son 1er mot (bug du script termux-api, pas le notre).
CHANNEL_NAME="Image-control"

# bascule un flag fichier : present -> absent, absent -> present.
toggle_flag() {
  if [ -e "$1" ]; then rm -f "$1"; else touch "$1"; fi
}

is_on() { [ -e "$1" ]; }

is_sshd_alive() {
  pgrep -x sshd >/dev/null 2>&1
}

is_supervisor_alive() {
  pgrep -f "$BOOT_WATCHER" >/dev/null 2>&1
}

is_watcher_alive() {
  pgrep -f "$RUNTIME_WATCHER" >/dev/null 2>&1
}

service_state() {
  if is_supervisor_alive && is_watcher_alive && is_sshd_alive; then
    printf online
  elif is_supervisor_alive && is_watcher_alive; then
    printf images-only
  else
    printf offline
  fi
}

flags_text() {
  if is_on "$ON_FLAG" && is_on "$PHOTOS_FLAG"; then
    printf 'Screenshots on - Photos on'
  elif is_on "$ON_FLAG"; then
    printf 'Screenshots on - Photos paused'
  elif is_on "$PHOTOS_FLAG"; then
    printf 'Screenshots paused - Photos on'
  else
    printf 'Watching paused'
  fi
}

status_text() {
  local flags state
  flags=$(flags_text)
  state=$(service_state)
  case "$state" in
    online)      printf '%s' "$flags" ;;
    images-only) printf '%s - ssh phone offline' "$flags" ;;
    *)           printf 'Service offline - open Termux' ;;
  esac
}

action_label() {
  local flag="$1" on_label="$2" off_label="$3"
  if is_on "$flag"; then printf '%s' "$on_label"; else printf '%s' "$off_label"; fi
}

restore() {
  # Repost immediat apres swipe. Le temps restant vient surtout du lancement de
  # l'action Termux:API/Android, pas de ce script.
  [ "$RESTORE_DELAY" = 0 ] || sleep "$RESTORE_DELAY"
  show
}

show() {
  command -v termux-notification >/dev/null 2>&1 || return 0
  local content shots_action photos_action
  content=$(status_text)
  shots_action=$(action_label "$ON_FLAG" "Pause screenshots" "Enable screenshots")
  photos_action=$(action_label "$PHOTOS_FLAG" "Pause photos" "Enable photos")

  # Channel dedie (best-effort) : isole cette notif permanente des autres notifs
  # Termux:API (ex notifs d'image d'img2clip), qui restent sur le channel
  # par defaut. termux-notification-channel est idempotent et NE reinitialise PAS les
  # reglages user d'un channel deja existant (importance/silence regles cote HyperOS
  # sont preserves). On n'ajoute --channel QUE si la creation reussit : un --channel
  # invalide -> notif NON envoyee (cf --help), donc en cas d'echec on retombe sur le
  # comportement d'avant (channel par defaut). Jamais de notif perdue = non-regression.
  local channel_args=()
  if command -v termux-notification-channel >/dev/null 2>&1 \
     && termux-notification-channel "$CHANNEL_ID" "$CHANNEL_NAME" >/dev/null 2>&1; then
    channel_args=(--channel "$CHANNEL_ID")
  fi

  termux-notification \
    --id "$NOTIF_ID" \
    "${channel_args[@]}" \
    --group "$GROUP_ID" \
    --icon image \
    --title "Images to PC" \
    --content "$content" \
    --ongoing \
    --priority low \
    --alert-once \
    --on-delete "$BASH_BIN $SELF restore" \
    --button1 "$shots_action" --button1-action "$BASH_BIN $SELF shots" \
    --button2 "$photos_action"  --button2-action "$BASH_BIN $SELF photos" \
    >/dev/null 2>&1 || true
}

case "${1:-show}" in
  photos) toggle_flag "$PHOTOS_FLAG"; show ;;
  shots)  toggle_flag "$ON_FLAG";     show ;;
  restore) restore ;;
  show)   show ;;
  *) echo "Usage: watcher-toggle {show|restore|photos|shots}" >&2; exit 1 ;;
esac
