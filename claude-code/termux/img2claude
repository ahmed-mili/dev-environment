#!/usr/bin/env bash
# img2claude — envoie l'image (photo OU capture) la plus recente du telephone
# dans la session Claude Code qui tourne sur le desktop, par-dessus mosh/Tailscale.
#
# Pourquoi ce detour : sur Termux -> mosh -> tmux -> Claude, le presse-papier du
# tel ne traverse pas mosh (OSC 52 avale), donc un "vrai" Alt+V cote tel est
# impossible. Solution : scp l'image au desktop, la mettre dans le clipboard
# Windows (via PowerShell SetImage), puis envoyer Alt+V dans la session tmux
# ou tourne Claude -> chat:imagePaste attache l'image au prompt.
#
# Pourquoi PAS wl-copy (Wayland) malgre WSLg : Claude Code v2.1.150+ extrait
# le clipboard avec cette chaine (cli.js, branche linux) :
#     wl-paste --type image/png || wl-paste --type image/bmp || powershell...
# Il ne demande JAMAIS image/jpeg. Si on wl-copy --type image/jpeg, wl-paste
# pour png/bmp renvoie rc=1 et le fichier reste a 0 byte -> Claude abandonne
# silencieusement. Le fallback PowerShell (Get-Clipboard -Format Image) est
# le seul qui accepte tous les formats source -> on cible directement celui-la.
#
# Pourquoi pas juste `tmux send-keys -l <path>` : un path brut tape dans le
# prompt n'est PAS auto-attache par Claude Code (verifie 2026-05-27, v2.1.150).
# Le clipboard + Alt+V est le seul chemin fiable.
#
# Usage (depuis une 2e session Termux) :  bash ~/img2claude
# Raccourci conseille : alias i='bash ~/img2claude'  (dans ~/.bashrc) -> on tape `i`.
#
# Prerequis (one-shot cote tel) :
#   - termux-setup-storage     (autorise l'acces a ~/storage, aucune app a installer)
#   - ssh par cle tel->desktop (deja le cas si tu moshes sans taper de mot de passe)

set -euo pipefail

DESK="ahmed@100.66.28.125"        # desktop via Tailscale (IP 100.x)
DEST_DIR="/home/ahmed/.claude-images"
TMUX_TARGET="main"                # session tmux ou tourne Claude

# Tout appel reseau est borne par `timeout` : sans ca, un cote desktop qui ne
# rend jamais la main (cf. l'ancien `wl-copy` qui forkait un serveur clipboard
# persistant tenant le canal SSH ouvert) gele indefiniment le screenshot-watcher
# qui nous appelle en boucle synchrone. BatchMode evite tout prompt interactif.
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=2)
NET_TIMEOUT=30

# Si un fichier est passe en argument (cas hook Termux: termux-file-editor), on
# l'envoie directement. Sinon, on scanne UN seul niveau de dossiers d'images
# (PAS de glob **: ~/storage/dcim est un symlink -> milliers de fichiers + SIGPIPE).
# La selection du plus recent se fait par une boucle `-nt` -> aucun pipe, robuste.
if [ "$#" -ge 1 ]; then
  newest="$1"
  [ -r "$newest" ] || { echo "Fichier illisible: $newest" >&2; exit 1; }
  ext="${newest##*.}"
  case "${ext,,}" in
    jpg|jpeg|png|webp) ;;
    *) echo "Type non supporte: .$ext (attendu: jpg/jpeg/png/webp)" >&2; exit 1 ;;
  esac
else
  shopt -s nullglob
  dirs=(
    "$HOME"/storage/dcim "$HOME"/storage/dcim/Camera "$HOME"/storage/dcim/Screenshots
    "$HOME"/storage/pictures "$HOME"/storage/pictures/Screenshots
    "$HOME"/storage/downloads
  )
  newest=""
  for d in "${dirs[@]}"; do
    for f in "$d"/*.jpg "$d"/*.jpeg "$d"/*.png "$d"/*.webp \
             "$d"/*.JPG "$d"/*.JPEG "$d"/*.PNG "$d"/*.WEBP; do
      [ -f "$f" ] || continue
      if [ -z "$newest" ] || [ "$f" -nt "$newest" ]; then
        newest="$f"
      fi
    done
  done
  if [ -z "$newest" ]; then
    echo "Aucune image trouvee dans dcim/pictures/downloads." >&2
    echo "As-tu lance 'termux-setup-storage' ?" >&2
    exit 1
  fi
fi

ext="${newest##*.}"
dest="img-$(date +%Y%m%d-%H%M%S).${ext}"

echo "-> $newest"
timeout "$NET_TIMEOUT" scp "${SSH_OPTS[@]}" -q "$newest" "$DESK:$DEST_DIR/$dest"
# Cote desktop, en une connexion :
#   1. purge auto (ne garde que les 30 plus recentes)
#   2. wslpath convertit /home/ahmed/... -> \\wsl.localhost\Ubuntu\home\ahmed\...
#      (powershell.exe tourne cote Windows et lit le FS WSL via UNC)
#   3. PowerShell -Sta SetImage met l'image (jpg/png/etc.) dans le clipboard
#      Windows. -Sta est obligatoire : System.Windows.Forms.Clipboard exige
#      un thread en apartment STA.
#   4. tmux send-keys M-v -> Alt+V dans Claude -> chat:imagePaste -> claude
#      essaie xclip png (fail), wl-paste png (fail), xclip bmp (fail), wl-paste
#      bmp (fail), puis powershell Get-Clipboard -Format Image -> SUCCES.
timeout "$NET_TIMEOUT" ssh "${SSH_OPTS[@]}" "$DESK" bash <<REMOTE
set -e
cd '$DEST_DIR'
ls -t | tail -n +31 | xargs -r rm -f --
export CLAUDE_IMG_WIN_PATH=\$(wslpath -w '$DEST_DIR/$dest')
# WSLENV est OBLIGATOIRE : WSL ne propage AUCUNE variable d'env Linux a un
# process Windows (powershell.exe) sans l'y declarer. Sans ca, \$env:CLAUDE_IMG_WIN_PATH
# est vide cote PowerShell -> FromFile('') -> \$img null -> SetImage(null) echoue.
export WSLENV=CLAUDE_IMG_WIN_PATH:\$WSLENV
ps_exe=\$(command -v powershell.exe 2>/dev/null || echo /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe)
# SetImage + VERIFICATION (retry x3) : le clipboard Windows est une ressource
# verrouillable ; si Claude (ou un autre img2claude rapproche) lit pendant qu'on
# ecrit, l'ecriture peut echouer silencieusement. On re-essaie tant que GetImage
# ne confirme pas, et on sort en erreur sinon -> grace a `set -e`, le M-v ci-dessous
# n'est PAS tire si le clipboard n'a pas l'image (evite un Alt+V "a vide" qui
# afficherait "No image found in clipboard" cote Claude).
# </dev/null est CRITIQUE : powershell.exe herite du stdin du heredoc et AVALE
# toutes les lignes restantes (dont le `tmux send-keys` ci-dessous) -> sans ca,
# le M-v n'est JAMAIS envoye et aucune image n'est collee (diagnostique 2026-05-27
# via instrumentation : le bloc distant s'arretait pile apres SetImage).
"\$ps_exe" -Sta -NoProfile -NonInteractive -Command 'Add-Type -AssemblyName System.Windows.Forms, System.Drawing; \$img = [System.Drawing.Image]::FromFile(\$env:CLAUDE_IMG_WIN_PATH); \$ok = \$false; for (\$i = 0; \$i -lt 3; \$i++) { try { [System.Windows.Forms.Clipboard]::SetImage(\$img); Start-Sleep -Milliseconds 150; if (\$null -ne [System.Windows.Forms.Clipboard]::GetImage()) { \$ok = \$true; break } } catch { Start-Sleep -Milliseconds 150 } }; \$img.Dispose(); if (-not \$ok) { exit 1 }' </dev/null >&2
tmux send-keys -t '$TMUX_TARGET' M-v
REMOTE
echo "OK. Image envoyee dans le prompt Claude (Alt+V auto)."
