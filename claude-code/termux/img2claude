#!/usr/bin/env bash
# img2claude — envoie l'image (photo OU capture) la plus recente du telephone
# dans la session Claude Code qui tourne sur le desktop, par-dessus mosh/Tailscale.
#
# Pourquoi ce detour : sur Termux -> mosh -> tmux -> Claude, le presse-papier du
# tel ne traverse pas mosh (OSC 52 avale), donc un "vrai" Alt+V est impossible.
# A la place : on prend le fichier le plus recent, on le scp au desktop, et on
# ecrit son chemin dans le prompt Claude via `tmux send-keys`. Claude Code attache
# l'image quand on valide un chemin de fichier image dans le prompt.
#
# Usage (depuis une 2e session Termux) :  bash ~/img2claude
# Raccourci conseille : alias i='bash ~/img2claude'  (dans ~/.bashrc) -> on tape `i`.
#
# Prerequis (one-shot cote tel) :
#   - termux-setup-storage     (autorise l'acces a ~/storage, aucune app a installer)
#   - ssh par cle tel->desktop (deja le cas si tu moshes sans taper de mot de passe)

set -euo pipefail

DESK="ahmed@100.66.28.125"        # desktop via Tailscale (IP 100.x)
DEST_DIR="/home/ahmed/.claude-images"
TMUX_TARGET="main"                # session tmux ou tourne Claude

# Si un fichier est passe en argument (cas hook Termux: termux-file-editor), on
# l'envoie directement. Sinon, on scanne UN seul niveau de dossiers d'images
# (PAS de glob **: ~/storage/dcim est un symlink -> milliers de fichiers + SIGPIPE).
# La selection du plus recent se fait par une boucle `-nt` -> aucun pipe, robuste.
if [ "$#" -ge 1 ]; then
  newest="$1"
  [ -r "$newest" ] || { echo "Fichier illisible: $newest" >&2; exit 1; }
  ext="${newest##*.}"
  case "${ext,,}" in
    jpg|jpeg|png|webp) ;;
    *) echo "Type non supporte: .$ext (attendu: jpg/jpeg/png/webp)" >&2; exit 1 ;;
  esac
else
  shopt -s nullglob
  dirs=(
    "$HOME"/storage/dcim "$HOME"/storage/dcim/Camera "$HOME"/storage/dcim/Screenshots
    "$HOME"/storage/pictures "$HOME"/storage/pictures/Screenshots
    "$HOME"/storage/downloads
  )
  newest=""
  for d in "${dirs[@]}"; do
    for f in "$d"/*.jpg "$d"/*.jpeg "$d"/*.png "$d"/*.webp \
             "$d"/*.JPG "$d"/*.JPEG "$d"/*.PNG "$d"/*.WEBP; do
      [ -f "$f" ] || continue
      if [ -z "$newest" ] || [ "$f" -nt "$newest" ]; then
        newest="$f"
      fi
    done
  done
  if [ -z "$newest" ]; then
    echo "Aucune image trouvee dans dcim/pictures/downloads." >&2
    echo "As-tu lance 'termux-setup-storage' ?" >&2
    exit 1
  fi
fi

dest="img-$(date +%Y%m%d-%H%M%S).${newest##*.}"

echo "-> $newest"
scp -q "$newest" "$DESK:$DEST_DIR/$dest"
# Cote desktop, en une connexion : purge auto (ne garde que les 30 plus recentes,
# sinon le dossier grossit a l'infini) PUIS injecte le chemin dans le prompt Claude.
# -l : insere la chaine litteralement (chemin + espace), sans l'executer.
ssh "$DESK" "cd '$DEST_DIR' && ls -t | tail -n +31 | xargs -r rm -f -- ; tmux send-keys -t '$TMUX_TARGET' -l '$DEST_DIR/$dest '"
echo "OK. Le chemin est dans le prompt Claude -> reviens sur la session et tape Entree."
