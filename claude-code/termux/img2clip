#!/usr/bin/env bash
# img2clip — envoie l'image (photo OU capture) la plus recente du telephone
# dans la session Claude Code qui tourne sur le desktop, par-dessus mosh/Tailscale.
#
# Pourquoi ce detour : sur Termux -> mosh -> tmux -> Claude, le presse-papier du
# tel ne traverse pas mosh (OSC 52 avale), donc un "vrai" Alt+V cote tel est
# impossible. Solution : streamer l'image par SSH vers le desktop, dans
# ~/.claude-images ; le watcher cote PC (img-clip-watcher.ps1, lance par le
# wrapper claude() du profil pwsh, DANS la logon session du lecteur) detecte
# l'arrivee et pousse l'image dans le presse-papiers Windows natif. L'user
# appuie Alt+V quand il veut envoyer (controle manuel, decision retiree
# d'img2clip 2026-05-27 : auto-paste = trop intrusif pour les photos perso).
#
# Pourquoi pas juste `tmux send-keys -l <path>` : un path brut tape dans le
# prompt n'est PAS auto-attache par Claude Code (verifie 2026-05-27, v2.1.152).
# Le clipboard + Alt+V est le seul chemin fiable.
#
# Usage :  bash ~/img2clip <fichier-image>
# Appele uniquement avec un chemin : par screenshot-watcher (auto-push des captures)
# et par le hook Share -> Termux -> EDIT (termux-file-editor, choix galerie).
# Le mode sans argument (scan de la + recente, alias `i`) a ete RETIRE le 2026-05-27 :
# l'auto-push du watcher le rend superflu.
#
# Prerequis (one-shot cote tel) :
#   - termux-setup-storage     (autorise l'acces a ~/storage, aucune app a installer)
#   - ssh par cle tel->desktop (deja le cas si tu moshes sans taper de mot de passe)

set -euo pipefail

# Tout appel reseau est borne par `timeout` : sans ca, un cote desktop qui ne
# rend jamais la main gele indefiniment le screenshot-watcher qui nous appelle
# en boucle synchrone. BatchMode evite tout prompt interactif.
SSH_OPTS=(-o BatchMode=yes -o LogLevel=ERROR -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=2)
NET_TIMEOUT=30

# Sonde de selection de la machine : delais courts, une machine eteinte ne doit
# pas couter plus que quelques secondes avant qu'on passe a la suivante.
PROBE_OPTS=(-o BatchMode=yes -o LogLevel=ERROR -o ConnectTimeout=3)
PROBE_TIMEOUT=8
# Age maximal du battement du watcher pour considerer une machine active. Le
# watcher ecrit toutes les 5 s : 60 s laisse de la marge pour un PC qui rame ou
# une horloge legerement desynchronisee, sans jamais retenir une session fermee.
ALIVE_MAX_AGE=60
ALIVE_FILE='.claude-images/.watcher-alive'
REMOTE_DIR='.claude-images'

# Host SSH du desktop (alias ~/.ssh/config du telephone, surchargeable via $DESK).
WIN_DESK="${WIN_DESK:-desktop}"
WIN_SSH_PORT="${WIN_SSH_PORT:-2222}"

# Termux:Boot lance le watcher avec un environnement minimal (HOME/PATH
# seulement). Charger les variables locales ici rend img2clip autonome, meme
# quand il n'est pas appele depuis un shell interactif.
if [ -f "$HOME/.bashrc.local" ]; then
  set +u
  # shellcheck disable=SC1090
  . "$HOME/.bashrc.local" >/dev/null 2>&1 || true
  set -u
fi

# Machines candidates, dans l'ordre de preference en cas d'egalite. Par defaut la
# seule machine historique : le depot reste mono-machine pour qui le clone. Ajouter
# des machines se fait hors depot (regle d'or n1, aucune valeur perso versionnee) :
#   ~/.bashrc.local :  export WIN_HOSTS="laptop desktop"
#   ~/.ssh/config   :  un bloc `Host laptop` avec son adresse, son port, son user
# Resolu APRES .bashrc.local pour heriter d'un WIN_DESK eventuellement surcharge.
WIN_HOSTS="${WIN_HOSTS:-$WIN_DESK}"

# Le pipeline legacy vers WSL a ete retire le 2026-06-13. Seul le depot natif
# Windows subsiste.
#
# TRANSPORT : SFTP, et surtout PAS une commande shell distante (root cause
# prouvee 2026-08-08). L'ancien envoi passait par
# `ssh <host> "pwsh -Command \"...\$dir...\""` avec l'image sur stdin. Des que
# HKLM\SOFTWARE\OpenSSH\DefaultShell vaut pwsh.exe, le shell de LOGIN interpole
# cette chaine avant de la transmettre : chaque \$variable devient vide et le
# script arrive syntaxiquement mort ("ParserError: An expression was expected
# after '('"). Le curseur du screenshot-watcher est reste fige 19 jours sans
# qu'aucune capture ne parte. Repro en une ligne :
#   ssh <host> "echo AVANT\$varInexistante APRES"   -> n'affiche que AVANT/APRES.
# SFTP est un protocole binaire : aucun shell distant n'entre en jeu, donc la
# panne est impossible par construction quel que soit le DefaultShell. Le
# sous-systeme sftp a ete verifie present sur les deux machines (2026-08-08) ;
# l'ancien commentaire qui l'ecartait datait d'une install OpenSSH obsolete.

# Un fichier image DOIT etre passe en argument (par screenshot-watcher ou par le
# hook termux-file-editor). Plus de mode "sans argument" (scan de la + recente) :
# retire le 2026-05-27, l'auto-push du watcher le remplace.
if [ "$#" -lt 1 ]; then
  echo "Usage: img2clip <fichier-image>" >&2
  echo "(le mode 'i' sans argument a ete retire : le screenshot-watcher pousse les captures tout seul)" >&2
  exit 1
fi
newest="$1"
[ -r "$newest" ] || { echo "Fichier illisible: $newest" >&2; exit 1; }
ext="${newest##*.}"
case "${ext,,}" in
  jpg|jpeg|png|webp) ;;
  *) echo "Type non supporte: .$ext (attendu: jpg/jpeg/png/webp)" >&2; exit 1 ;;
esac

# --- Bouton "Open image" de la notif finale -----------------------------------
# Ouvre l'image envoyee dans la visionneuse Android par defaut. PAS termux-open :
# son FileProvider (content://com.termux.files/...) sert des metadonnees vides
# (0 octet / 0x0px) a la galerie MIUI/HyperOS -> "fichier corrompu" (constate
# 2026-06-12). Le seul chemin fiable : l'`am` de Termux (PAS /system/bin/am,
# SecurityException uid) + URI file:// vers le stockage partage, que la galerie
# lit directement avec ses propres permissions media.
# Contraintes des actions termux-notification (cf --help-actions) :
#   - executees par `dash -c` SANS environnement (pas de $PATH) -> chemins absolus
#   - %q blinde le path pour le shell (les paths DCIM/Screenshots n'ont pas d'espace)
AM_BIN="/data/data/com.termux/files/usr/bin/am"
real_path=$(readlink -f "$newest")
case "${ext,,}" in
  jpg|jpeg) mime="image/jpeg" ;;
  png)      mime="image/png" ;;
  webp)     mime="image/webp" ;;
esac
open_action="$AM_BIN start -a android.intent.action.VIEW -d file://$(printf '%q' "$real_path") -t $mime >/dev/null 2>&1"

ext="${newest##*.}"
# dest DETERMINISTE (hash du chemin source) : le watcher re-appelle avec la meme
# source sur echec -> meme dest. Avant : un timestamp neuf a chaque appel
# creait un nouveau fichier a chaque retry. Effet de bord mineur :
# ~/.claude-images contient img-<hash>.ext.
dest="img-$(printf '%s' "$newest" | md5sum | cut -c1-12).${ext}"
total_bytes=$(stat -c '%s' "$newest" 2>/dev/null || printf '0')

echo "-> $newest"

# --- Notifications Android (meme id, remplacees en place) ----------------------
# Termux:API ne propose pas encore de vraie barre native setProgress() pour
# termux-notification. On affiche donc l'etat final : image deposee sur le PC (le clipboard pwsh
# natif est rempli cote PC par img-clip-watcher.ps1 en <= 1 s, non observable
# d'ici — on ne pretend donc plus le "confirmer").
have_notif=0; img_channel=(); staged=0; failure_notified=0
IMG_GROUP="watcher-images"

format_mb() {
  awk -v bytes="${1:-0}" 'BEGIN { printf "%.2f MB", bytes / 1048576 }'
}

progress_content() {
  local pct="${1%%%}" done_bytes="${2:-}" eta_label=""
  case "$pct" in ''|*[!0-9]* ) pct=0 ;; esac
  case "$done_bytes" in ''|*[!0-9]* )
    if [ "${total_bytes:-0}" -gt 0 ]; then
      done_bytes=$((total_bytes * pct / 100))
    else
      done_bytes=0
    fi
    ;;
  esac
  [ "$done_bytes" -gt "${total_bytes:-0}" ] && done_bytes="${total_bytes:-0}"
  if [ -n "${transfer_started_at:-}" ] && [ "$pct" -gt 0 ] && [ "$pct" -lt 100 ]; then
    local now elapsed eta
    now=$(date +%s)
    elapsed=$((now - transfer_started_at))
    eta=$(((elapsed * (100 - pct) + pct - 1) / pct))
    [ "$eta" -gt 1 ] && eta_label=" - ${eta}s remaining"
  fi
  if [ "${total_bytes:-0}" -gt 0 ]; then
    printf '%s / %s - %s%%%s' "$(format_mb "$done_bytes")" "$(format_mb "$total_bytes")" "$pct" "$eta_label"
  else
    printf '%s%%%s' "$pct" "$eta_label"
  fi
}

notify_img() {
  [ "$have_notif" = 1 ] || return 0
  termux-notification --id img2clip "${img_channel[@]}" --group "$IMG_GROUP" "$@" >/dev/null 2>&1 || true
}

if command -v termux-notification >/dev/null 2>&1; then
  have_notif=1
  # Channel dedie (best-effort) : nom SANS espace (termux-notification-channel expanse
  # $ARGS non-quote -> tronque a la 1re espace, cf reference_termux-notification-channels).
  if command -v termux-notification-channel >/dev/null 2>&1 \
     && termux-notification-channel watcher-images "Image-ready" >/dev/null 2>&1; then
    img_channel=(--channel watcher-images)
  fi
  notify_img --ongoing --icon sync --title "Sending image to PC" \
    --content "$(progress_content 0)"
  # SECURITE : si on sort AVANT le succes (scp/stage rate, timeout), le ⏳ ne doit pas
  # rester fige. trap EXIT -> retire la notif tant que staged != 1. On capture puis
  # re-emet $? (exit $rc) pour NE PAS masquer le code d'echec : le watcher gate
  # l'avancement du curseur sur le code retour d'img2clip (`if bash img2clip; then
  # avance-curseur`). Masquer un echec = curseur avance = image RATEE crue envoyee.
  trap 'rc=$?; [ "$staged" = 1 ] || [ "$failure_notified" = 1 ] || { command -v termux-notification-remove >/dev/null 2>&1 && termux-notification-remove img2clip >/dev/null 2>&1; }; exit $rc' EXIT
fi

# Destination SSH d'un alias : WIN_REMOTE surcharge tout (mono-machine explicite),
# sinon WIN_USER prefixe l'alias, sinon on laisse ~/.ssh/config du telephone
# fournir le User. Aucune valeur perso n'est ainsi versionnee ici.
remote_for() {
  if [ -n "${WIN_REMOTE:-}" ]; then printf '%s' "$WIN_REMOTE"
  elif [ -n "${WIN_USER:-}" ]; then printf '%s@%s' "$WIN_USER" "$1"
  else printf '%s' "$1"
  fi
}

# --- Choix de la machine cible -------------------------------------------------
# Une seule connexion SFTP par machine donne les DEUX informations utiles :
#   connexion refusee            -> machine injoignable, ecartee
#   connexion OK, fichier absent -> joignable, aucune session Claude ouverte
#   fichier recupere et frais    -> machine active, candidate
# Le `-` devant `get` est la tolerance d'erreur de `sftp -b` : un fichier absent
# n'echoue pas le lot, c'est ce qui permet de separer les deux derniers cas sans
# payer une seconde connexion.
# Aucune machine active -> on retombe sur la premiere joignable : l'image attend
# dans ~/.claude-images et sera collable au prochain demarrage de Claude. Echouer
# ici ferait vibrer le telephone en boucle pour une capture parfaitement livrable.
PROBE_DIR="$HOME/.cache"
mkdir -p "$PROBE_DIR" 2>/dev/null || true

# Le PREMIER host actif dans l'ordre de WIN_HOSTS gagne, on ne cherche pas le
# battement le plus recent : les watchers ecrivent tous les 5 s, donc departager
# deux machines actives au timestamp reviendrait a tirer au sort selon l'instant
# de la sonde. L'ordre de WIN_HOSTS est deterministe et previsible, et sortir des
# la premiere machine active economise la sonde des suivantes.
pick_target() {
  local host probe alive now fallback=''
  now=$(date +%s)
  for host in $WIN_HOSTS; do
    probe="$PROBE_DIR/img2clip-alive-$host"
    rm -f "$probe"
    printf -- '-get %s %s\n' "$ALIVE_FILE" "$probe" \
      | timeout "$PROBE_TIMEOUT" sftp "${PROBE_OPTS[@]}" -P "$WIN_SSH_PORT" -b - \
          "$(remote_for "$host")" >/dev/null 2>&1 || continue
    [ -n "$fallback" ] || fallback="$host"
    # tr -cd : le fichier ne contient qu'un epoch, mais on se blinde contre un
    # CRLF ou un BOM qui rendrait la comparaison arithmetique fatale (set -e).
    # `if` explicite et pas `[ -s ] && alive=...` : sous set -e, une liste `&&`
    # dont le test echoue renvoie 1 et tuerait le script.
    alive=''
    if [ -s "$probe" ]; then alive=$(tr -cd '0-9' < "$probe" || true); fi
    [ -n "$alive" ] || continue
    [ "$((now - alive))" -le "$ALIVE_MAX_AGE" ] || continue
    printf '%s' "$host"
    return 0
  done
  printf '%s' "$fallback"
}

target_host=$(pick_target)

rc=0
if [ -z "$target_host" ]; then
  rc=255   # aucune machine joignable : meme message que l'echec SSH classique
else
  notify_img --ongoing --alert-once --icon sync --title "Sending image to PC" \
    --content "Transferring to $target_host..."
  # -mkdir tolere l'echec : creation idempotente du depot sans commande shell.
  printf -- '-mkdir %s\nput "%s" "%s/%s"\n' "$REMOTE_DIR" "$newest" "$REMOTE_DIR" "$dest" \
    | timeout "$NET_TIMEOUT" sftp "${SSH_OPTS[@]}" -P "$WIN_SSH_PORT" -b - \
        "$(remote_for "$target_host")" >/dev/null 2>&1 || rc=$?
fi
if [ "$rc" != 0 ]; then
  failure_notified=1
  if [ "$have_notif" = 1 ]; then
    case "$rc" in
      124) fail_msg="PC unreachable or transfer timed out - reconnect Tailscale, then retry" ;;
      255) fail_msg="SSH to PC failed - reconnect Tailscale or restart sshd" ;;
      *)   fail_msg="Transfer failed (rc=$rc) - screenshot will retry" ;;
    esac
    notify_img --icon error --title "Image not sent" \
      --content "$fail_msg" --priority high --vibrate 200
  fi
  exit "$rc"
fi

# No SetImage over SSH here: the Windows watcher, launched beside Claude,
# observes %USERPROFILE%\.claude-images in the reader's window station.
staged=1
echo "OK. Image staged on $target_host (native Windows watcher takes over)."
if [ "$have_notif" = 1 ]; then
  # Bouton "Open image" : ouvre l'image envoyee dans la visionneuse par defaut
  # (cf. open_action en tete : am + file://, JAMAIS termux-open -> galerie MIUI
  # voit 0 octet). Bouton explicite plutot que tap-sur-notif : plus intuitif.
  notify_img --icon check_circle --title "Image ready on $target_host" \
    --content "Copied to the Windows clipboard - ready to paste" --priority high --vibrate 200 \
    --led-color 00c853 --led-on 250 --led-off 1000 \
    --button1 "Open image" --button1-action "$open_action"
else
  printf '\a' >&2
fi
