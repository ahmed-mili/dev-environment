#!/usr/bin/env bash
# screenshot-watcher — pousse automatiquement chaque NOUVELLE image du telephone
# dans la session Claude Code du desktop, via img2claude.
#
# Deux flux, deux flags :
#   ~/.screenshot-watcher.on       -> surveille les CAPTURES  (dcim/Screenshots)
#   ~/.screenshot-watcher.photos   -> surveille EN PLUS les PHOTOS (dcim/Camera)
# Les DEUX flux sont ON par defaut (crees par install.sh, flags persistants dans
# $HOME). Le flux photos etait historiquement OFF "pour ne pas que chaque photo
# perso parte dans Claude" -- ce motif a DISPARU : img2claude ne fait plus que
# STAGER l'image dans le presse-papier desktop (l'envoi reste un Alt+V MANUEL de
# l'user, cf. img2claude). Une photo stagee n'entre donc dans Claude que si l'user
# le decide -> aucun risque de deversement automatique, photos ON par defaut est sur.
#
# Toggle sans tuer le service (la boucle relit le flag a chaque tour) :
#   touch ~/.screenshot-watcher.on      (captures ON)    / rm = OFF
#   touch ~/.screenshot-watcher.photos  (photos ON)      / rm = OFF
#   (alias pratiques cote Termux : photos-on / photos-off)
#
# Pourquoi polling et pas inotify : sur /sdcard (FUSE), inotify ne recoit pas les
# events des autres apps (l'app Camera/Screenshot ecrit sous la couche emulee).
# Polling court = retour visuel quasi immediat ; le find reste borne a maxdepth 1.
#
# Lancement manuel : nohup bash ~/bin/screenshot-watcher >/dev/null 2>&1 &
# Autostart boot   : via ~/.termux/boot/screenshot-watcher (Termux:Boot).

set -uo pipefail

SHOTS_DIR="$HOME/storage/dcim/Screenshots"
PHOTOS_DIR="$HOME/storage/dcim/Camera"
FLAG="$HOME/.screenshot-watcher.on"
PHOTOS_FLAG="$HOME/.screenshot-watcher.photos"
SHOTS_STATE="$HOME/.cache/screenshot-watcher.last-mtime"
PHOTOS_STATE="$HOME/.cache/screenshot-watcher.photos-mtime"
INTERVAL=0.5
DISABLED_INTERVAL=2
STABLE_INTERVAL=0.15
STABLE_TRIES=14
NOTIF_ID="img2claude"
CHANNEL_ID="watcher-images"
CHANNEL_NAME="Image-ready"
GROUP_ID="watcher-images"

mkdir -p "$(dirname "$SHOTS_STATE")"

# mtime du fichier image le plus recent d'un dossier (0 si vide). Sert de baseline
# pour ne pas re-envoyer tout l'historique au 1er passage / a l'activation d'un flux.
# `! -name '.*'` exclut les fichiers temporaires que MIUI/Android ecrit AVANT le
# renommage final (ex: `.pending-<ts>-Screenshot_xxx.jpg`) -> sinon une seule prise
# est vue 2x (le .pending PUIS le fichier final) -> image collee en double.
#
# Le max est calcule par awk (PAS `sort -rn | head -1`) pour une raison structurelle :
# sous `set -o pipefail`, le `head -1` ferme le pipe -> `sort` recoit SIGPIPE ->
# le pipeline sort en non-zero. Combine au `... || echo 0` de l'appelant, ca
# AJOUTAIT un "0" en 2e ligne au fichier d'etat (valeur deja emise + echo 0) ->
# cutoff multi-ligne "<ts>\n0" -> `find -newermt "@<ts>\n0"` echoue ("cannot
# interpret as date") -> watcher FIGE, plus aucune capture livree (diagnostique
# 2026-05-29, declenche par un reset du state). awk consomme tout le flux (pas de
# SIGPIPE) et imprime TOUJOURS exactement une valeur (0 si vide) -> plus besoin
# du `|| echo 0`, plus de corruption possible.
baseline_of() {
  find "$1" -maxdepth 1 -type f ! -name '.*' \
       \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
       -printf '%T@\n' 2>/dev/null \
    | awk 'NR==1 || $1>m {m=$1; s=$1} END {print (NR ? s : "0")}'
}
# NB awk : on compare numeriquement ($1>m) mais on imprime la CHAINE d'origine (s),
# jamais `m+0`. Sinon awk convertit en nombre et printf %s applique CONVFMT=%.6g ->
# le %T@ fractionnaire (ex 1780050672.6538521200) sort en "1.78005e+09" (notation
# scientifique) que `find -newermt` refuse. `NR ? s : "0"` -> "0" si dossier vide.

notify_detected() {
  command -v termux-notification >/dev/null 2>&1 || return 0
  local channel_args=()
  if command -v termux-notification-channel >/dev/null 2>&1 \
     && termux-notification-channel "$CHANNEL_ID" "$CHANNEL_NAME" >/dev/null 2>&1; then
    channel_args=(--channel "$CHANNEL_ID")
  fi
  termux-notification \
    --id "$NOTIF_ID" \
    "${channel_args[@]}" \
    --group "$GROUP_ID" \
    --title "Image detected" \
    --content "Preparing PC clipboard" \
    --ongoing \
    --priority high \
    >/dev/null 2>&1 || true
}

wait_until_stable() {
  local file="$1" prev="" size i
  for i in $(seq 1 "$STABLE_TRIES"); do
    [ -r "$file" ] || return 1
    size=$(stat -c '%s' "$file" 2>/dev/null || printf '')
    if [ -n "$size" ] && [ "$size" = "$prev" ] && [ "$size" -gt 0 ]; then
      return 0
    fi
    prev="$size"
    sleep "$STABLE_INTERVAL"
  done
  return 1
}

newest_after() {
  local dir="$1" cutoff="$2"
  find "$dir" -maxdepth 1 -type f ! -name '.*' \
       \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
       -newermt "@$cutoff" -printf '%T@\t%p\n' 2>/dev/null \
    | awk -F '\t' 'NR==1 || $1>best {best=$1; line=$0} END {if (NR) print line}'
}

# Stage UNIQUEMENT l'image la plus recente plus neuve que le cutoff, et avance le
# curseur par-dessus toutes les autres (les intermediaires sont volontairement
# sautees). Pourquoi PAS un FIFO de tout le backlog : le presse-papier Wayland ne
# tient qu'UNE image (Alt+V n'en colle qu'une), et chaque scp ~1 Mo prend 10-20 s
# sur cellulaire. Rejouer le backlog en serie faisait que le presse-papier
# refletait une capture vieille de plusieurs crans au moment du Alt+V (retard
# observe + diagnostique 2026-05-29 : clipboard = avant-derniere capture pendant
# que la derniere etait encore en upload). En convergeant direct vers la plus
# recente, le retard devient impossible par construction.
process_dir() {
  local dir="$1" state="$2" cutoff mtime file
  cutoff=$(head -n 1 "$state" 2>/dev/null || echo 0)
  IFS=$'\t' read -r mtime file < <(newest_after "$dir" "$cutoff")
  [ -n "$file" ] || return 0
  notify_detected "$file"
  wait_until_stable "$file" || return 0
  # Curseur avance UNIQUEMENT si img2claude reussit. Sinon (scp timeout en
  # tunnel/RER...) on garde le cutoff -> la capture sera RE-tentee au prochain
  # tour, jamais perdue silencieusement. Comme on vise toujours la PLUS recente,
  # une capture encore plus neuve qui arrive entre-temps prend la priorite (la
  # bloquee est sautee naturellement, pas de wedge permanent).
  if bash "$HOME/img2claude" "$file" </dev/null >/dev/null 2>&1; then
    echo "$mtime" > "$state"
  fi
}

while :; do
  active=0

  # --- Flux CAPTURES ---
  if [ -e "$FLAG" ]; then
    active=1
    # A l'activation : baseline sur la capture la plus recente, pour NE PAS
    # envoyer ce qui a ete pris pendant la pause. baseline_of imprime toujours
    # une seule valeur propre (0 si vide) -> pas de fallback `|| echo 0`.
    [ -s "$SHOTS_STATE" ] || baseline_of "$SHOTS_DIR" > "$SHOTS_STATE"
    process_dir "$SHOTS_DIR" "$SHOTS_STATE"
  else
    rm -f "$SHOTS_STATE"
  fi

  # --- Flux PHOTOS ---
  if [ -e "$PHOTOS_FLAG" ]; then
    active=1
    # A l'activation (state absent) : baseline sur la photo la plus recente, pour
    # NE PAS deverser tout l'historique Camera d'un coup. Seules les photos prises
    # APRES l'activation partiront.
    [ -s "$PHOTOS_STATE" ] || baseline_of "$PHOTOS_DIR" > "$PHOTOS_STATE"
    process_dir "$PHOTOS_DIR" "$PHOTOS_STATE"
  else
    # Flag retire -> on oublie le cutoff pour re-baseliner a la prochaine activation.
    rm -f "$PHOTOS_STATE"
  fi

  if [ "$active" = 1 ]; then
    sleep "$INTERVAL"
  else
    sleep "$DISABLED_INTERVAL"
  fi
done
