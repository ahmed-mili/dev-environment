#!/data/data/com.termux/files/usr/bin/bash
# Termux:Widget - "Envoyer un fichier a Claude"
#
# Pour les fichiers non-image (PDF, MD, code, JSON, etc.). Le file picker
# natif Android s'ouvre, l'user choisit un fichier, et celui-ci est :
#   1. scp vers ~/.claude-files/<original-name> sur le PC
#   2. Un symlink ~/.claude-files/last pointe vers le dernier transfere
#      (pour pouvoir dire "lis le dernier" sans connaitre le nom exact).
#   3. Toast affichant le chemin complet cote PC.
#
# Cote Claude (PC), l'user peut alors :
#   - taper "@~/.claude-files/last" pour attacher le fichier (Claude Code
#     v2.x reconnait les @-references et lit le fichier)
#   - ou dire simplement "lis le dernier fichier" -- Claude va Read sur
#     ~/.claude-files/last
#
# Pas zero-typing total (l'user doit referencer le fichier cote Claude),
# mais pas de tracking de path complexe : "@last" suffit toujours.

set -uo pipefail

DESK="ahmed@100.66.28.125"
DEST_DIR="/home/ahmed/.claude-files"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10)

TMP="$HOME/.cache/claudfile-$(date +%s%N).bin"
mkdir -p "$(dirname "$TMP")"

termux-storage-get "$TMP"

if [ ! -s "$TMP" ]; then
    termux-toast -b "#333" -c "#fff" "Annule"
    rm -f "$TMP"
    exit 0
fi

# Detecter l'extension via `file` (l'API Android ne propage pas toujours
# le nom original ; on fallback sur "bin"). Pas critique : c'est juste pour
# que Claude voie une extension utile quand il Read le fichier.
EXT=$(file --brief --mime-type "$TMP" 2>/dev/null | sed 's|.*/||')
case "$EXT" in
    pdf|markdown|x-markdown) ;;  # garde tel quel
    plain) EXT=txt ;;
    json|xml|html|csv) ;;
    *) EXT=bin ;;
esac
TARGET_NAME="upload-$(date +%Y%m%d-%H%M%S).$EXT"

# Borne reseau pour ne pas hang si Tailscale tombe entre temps
if ! timeout 30 scp "${SSH_OPTS[@]}" "$TMP" "$DESK:$DEST_DIR/$TARGET_NAME" >/dev/null 2>&1; then
    termux-toast -b "#c82333" -c "#fff" "scp echoue (Tailscale OK ?)"
    rm -f "$TMP"
    exit 1
fi

# Mettre a jour le symlink "last" cote PC
timeout 10 ssh "${SSH_OPTS[@]}" "$DESK" "ln -sfn '$DEST_DIR/$TARGET_NAME' '$DEST_DIR/last'" >/dev/null 2>&1 || true

termux-toast -b "#1e7e34" -c "#fff" "$TARGET_NAME -> ~/.claude-files/last"

rm -f "$TMP"
