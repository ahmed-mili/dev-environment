#!/data/data/com.termux/files/usr/bin/bash
# Wrapper Termux:Boot pour screenshot-watcher AVEC SUPERVISOR.
# A deposer en ~/.termux/boot/screenshot-watcher sur le telephone (chmod +x).
#
# Shebang ABSOLU obligatoire (pas `#!/usr/bin/env bash`) : Termux:Boot execute
# ses scripts SANS termux-exec (le LD_PRELOAD qui reecrit /usr/bin/env -> chemin
# Termux). Au boot, le noyau cherche donc litteralement /usr/bin/env, qui
# n'existe pas dans Termux -> le script ne demarre jamais. En interactif ca
# marche (termux-exec present), d'ou un bug invisible jusqu'au 1er vrai boot.
# Confirme 2026-05-27 : start-sshd (shebang absolu) montait au boot, ce script
# (env) non. Cf. le meme shebang absolu sur start-sshd.
#
# termux-wake-lock : sans ca, Android tue le process des que l'ecran s'eteint.
# Le wake lock se voit dans la notif Termux ("Acquired wakelock") -> permet
# d'arreter d'un swipe si besoin. Cout batterie reel : negligeable pour un
# polling 2s qui ne fait qu'un find toutes les 2s.
#
# SUPERVISOR : relance le watcher s'il meurt (crash, OOM, etc). Log chaque
# redemarrage dans ~/.screenshot-watcher.log pour debug post-mortem. Backoff
# 5s entre tentatives pour eviter une boucle d'enfer si bug recurrent.

LOG="$HOME/.screenshot-watcher.log"
WATCHER="$HOME/bin/screenshot-watcher"
PIDFILE="$HOME/.screenshot-watcher.pid"

log() { echo "[$(date +%Y-%m-%d_%H:%M:%S)] $*" >> "$LOG"; }

# PID file pour le fallback bashrc (cf. android/files/bashrc) : detecte si le
# supervisor tourne sans matcher la cmdline (qui contient 'screenshot-watcher'
# et risquerait l'auto-match du shell qui execute pgrep, cf.
# reference_pkill-f-self-match). Cleanup au exit pour ne pas laisser un PID
# fantome bloquer le relancement au prochain demarrage de l'app Termux.
echo $$ > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT INT TERM

termux-wake-lock
log "BOOT supervisor demarre - wake-lock acquis (PID $$)"

# Re-poste la notif-toggle au boot : c'est LE point de controle des flux, elle doit
# toujours etre presente. termux-wake-lock ci-dessus a deja prouve que Termux:API
# repond, donc termux-notification marchera aussi. Guarde par || true.
"$HOME/bin/watcher-toggle" show 2>/dev/null || true
log "notif-toggle (re)postee au boot"

while true; do
    log "Lancement watcher (PID parent $$)"
    bash "$WATCHER"
    EXIT_CODE=$?
    log "Watcher MORT (exit=$EXIT_CODE) - relance dans 5s"
    sleep 5
done
