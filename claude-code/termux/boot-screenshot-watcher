#!/data/data/com.termux/files/usr/bin/bash
# Wrapper Termux:Boot pour screenshot-watcher AVEC SUPERVISOR.
# A deposer en ~/.termux/boot/screenshot-watcher sur le telephone (chmod +x).
#
# Shebang ABSOLU obligatoire (pas `#!/usr/bin/env bash`) : Termux:Boot execute
# ses scripts SANS termux-exec (le LD_PRELOAD qui reecrit /usr/bin/env -> chemin
# Termux). Au boot, le noyau cherche donc litteralement /usr/bin/env, qui
# n'existe pas dans Termux -> le script ne demarre jamais. En interactif ca
# marche (termux-exec present), d'ou un bug invisible jusqu'au 1er vrai boot.
# Confirme 2026-05-27 : start-sshd (shebang absolu) montait au boot, ce script
# (env) non. Cf. le meme shebang absolu sur start-sshd.
#
# termux-wake-lock : sans ca, Android tue le process des que l'ecran s'eteint.
# Le wake lock se voit dans la notif Termux ("Acquired wakelock") -> permet
# d'arreter d'un swipe si besoin. Cout batterie reel : negligeable pour un
# polling court qui ne fait qu'un find borne a maxdepth 1.
#
# SUPERVISOR : relance le watcher s'il meurt (crash, OOM, etc). Log chaque
# redemarrage dans ~/.screenshot-watcher.log pour debug post-mortem. Backoff
# 5s entre tentatives pour eviter une boucle d'enfer si bug recurrent.

LOG="$HOME/.screenshot-watcher.log"
WATCHER="$HOME/bin/screenshot-watcher"
LOCKFILE="$HOME/.screenshot-watcher.lock"

log() { echo "[$(date +%Y-%m-%d_%H:%M:%S)] $*" >> "$LOG"; }

# VERROU EXCLUSIF anti-double-superviseur (remplace l'ancien PID file, qui etait
# TOCTOU : le fallback bashrc et le replay Termux:Boot pouvaient lire le PID file
# vide/mort au meme instant et lancer CHACUN un superviseur -> 2 watchers en
# parallele, double notif + double envoi de la meme capture, constate 2026-05-29).
#
# flock rend le double IMPOSSIBLE par construction, quelle que soit la source du
# lancement (bashrc, Termux:Boot, install.sh, manuel) :
#   - `exec 9>` ouvre le lockfile sur le FD 9 ; le FD reste ouvert toute la vie
#     du process -> le verrou est tenu tant que CE superviseur vit.
#   - `flock -n 9` est atomique (acquire-or-fail), pas de fenetre TOCTOU. Si un
#     autre superviseur tient deja le verrou, on sort en no-op silencieux (exit 0
#     AVANT tout log) -> aucun effet de bord, aucune ligne parasite dans le log.
#   - Liberation AUTOMATIQUE a la mort du process, meme SIGKILL/OOM par HyperOS
#     (le kernel ferme le FD) -> fini les PID fantomes/recycles du PID file.
# Le watcher enfant herite le FD 9 : voulu. Le verrou couvre alors superviseur +
# watcher, donc le double watcher reste impossible meme si le superviseur seul
# etait tue (un nouveau ne demarre qu'une fois l'orphelin mort).
exec 9>"$LOCKFILE" || exit 1
flock -n 9 || exit 0

# PURGE DES ORPHELINS : on vient d'acquerir le lock, donc tout watcher deja
# vivant est par definition un orphelin hors-supervision (superviseur tue par
# le Phantom Process Killer HyperOS, FD 9 perdu en route...). Constate
# 2026-06-12 : watcher ppid 1 sans FD 9, lock libre -> le prochain login
# bashrc aurait lance un 2e watcher en parallele (double notif/envoi). On
# tue ces orphelins AVANT de lancer le notre : l'etat redevient sain tout
# seul a chaque boot / login. pkill -f cible le chemin exact du watcher ;
# $$ et nos enfants ne matchent pas (on n'a pas encore lance le watcher).
if pkill -f "bash $WATCHER" 2>/dev/null; then
  log "orphelin(s) watcher purge(s) (lock etait libre)"
  sleep 1
fi

termux-wake-lock
log "BOOT supervisor demarre - wake-lock acquis (PID $$)"

# Re-poste la notif-toggle au boot : c'est LE point de controle des flux, elle doit
# toujours etre presente. termux-wake-lock ci-dessus a deja prouve que Termux:API
# repond, donc termux-notification marchera aussi. Guarde par || true.
"$HOME/bin/watcher-toggle" show 2>/dev/null || true
log "notif-toggle (re)postee au boot"

while true; do
    log "Lancement watcher (PID parent $$)"
    bash "$WATCHER"
    EXIT_CODE=$?
    log "Watcher MORT (exit=$EXIT_CODE) - relance dans 5s"
    sleep 5
done
