#!/usr/bin/env bash
# clip-watcher-bridge v10 — pousse le PNG dans Wayland avec FENÊTRE DE DÉFENSE
# allongée + sortie anticipée par convergence.
#
# Historique du bug (2026-05-28, bug v9 reproduit en repro contrôlée) :
#   - PS v3 vide le clipboard Windows après extraction → WSLg syncrait UNE fois,
#     croyait-on. FAUX : WSLg overwrite EN BOUCLE pendant ~3-5s, écrasant notre
#     wl-copy à CHAQUE re-push (15 re-push perdus en 4s à polling 0.3s). Après les
#     5s de la défense v9, le bridge lâchait → clipboard vide définitif.
#
# Conception v10 :
#   1. Polling 0.1s (au lieu de 0.3) : réagir à WSLg avant qu'il re-écrase.
#   2. DEFEND_WINDOW_S = 30s (au lieu de 5) : passé qq secondes WSLg lâche, on a
#      besoin de tenir jusque-là. L'user veut Alt+V dans les 30s -> OK.
#   3. Sortie anticipée par CONVERGENCE : dès que wl-paste voit notre image/png
#      pendant STABLE_TICKS=30 ticks consécutifs (3s à 0.1s/tick), on sort de la
#      défense plus tôt → user retrouve le contrôle du clipboard.
#
# WAYLAND_DISPLAY/XDG_RUNTIME_DIR hérités du supervisor.

set -uo pipefail

PNG=/tmp/clip-latest.png
FLAG=/tmp/clip-latest.flag
LOG=$HOME/.clip-watcher.log
POLL_S=0.1
DEFEND_WINDOW_S=30
STABLE_TICKS=30   # 30 × 0.1s = 3s de stabilité = WSLg a lâché

OUR_WLCOPY_PID=""
LAST_HASH=""
DEFEND_UNTIL=0
STABLE_COUNT=0

log() { echo "[$(date +%H:%M:%S)] bridge: $*" >> "$LOG"; }

push() {
    [[ -n "$OUR_WLCOPY_PID" ]] && kill "$OUR_WLCOPY_PID" 2>/dev/null
    setsid wl-copy --type image/png < "$PNG" >/dev/null 2>&1 &
    OUR_WLCOPY_PID=$!
}

log "v10 démarré (PID $$, poll=${POLL_S}s, défense=${DEFEND_WINDOW_S}s, stable=${STABLE_TICKS}t)"

while true; do
    sleep "$POLL_S"

    [[ -f "$PNG" && -f "$FLAG" ]] || continue
    CURRENT_HASH=$(cat "$FLAG" 2>/dev/null)
    [[ -n "$CURRENT_HASH" ]] || continue

    NOW=$(date +%s)

    # Nouvelle image → push + (ré)armer la fenêtre + reset stable counter
    if [[ "$CURRENT_HASH" != "$LAST_HASH" ]]; then
        push
        LAST_HASH="$CURRENT_HASH"
        DEFEND_UNTIL=$((NOW + DEFEND_WINDOW_S))
        STABLE_COUNT=0
        log "push hash=${CURRENT_HASH:0:8} (défense ${DEFEND_WINDOW_S}s, poll ${POLL_S}s)"
        continue
    fi

    # Pendant la fenêtre : vérifier l'état du clipboard.
    if (( NOW < DEFEND_UNTIL )); then
        if [[ "$(wl-paste --list-types 2>/dev/null)" == *"image/png"* ]]; then
            # Notre PNG tient. Incrémenter compteur de stabilité.
            STABLE_COUNT=$((STABLE_COUNT + 1))
            if (( STABLE_COUNT >= STABLE_TICKS )); then
                # WSLg a lâché. Sortir de la défense pour rendre le clipboard
                # à l'user (il peut copier texte/autre).
                log "convergence hash=${CURRENT_HASH:0:8} (stable ${STABLE_TICKS}t, défense relâchée)"
                DEFEND_UNTIL=0
            fi
        else
            # WSLg a écrasé. Re-push immédiat.
            push
            STABLE_COUNT=0
            log "re-push hash=${CURRENT_HASH:0:8} (défense active, WSLg overwrite)"
        fi
    fi
done
