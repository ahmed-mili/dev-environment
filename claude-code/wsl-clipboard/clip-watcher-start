#!/usr/bin/env bash
# clip-watcher-start — relance le supervisor en FILET DE SECOURS.
#
# Autostart PRINCIPAL = service systemd-user `clip-watcher.service` (+ linger),
# qui démarre au boot de la distro sans terminal ouvert. Ce script n'est qu'un
# filet : il est appelé par le .bashrc du 1er terminal WSL et ne sert que si le
# service est mort/désactivé.
#
# Anti-doublon : le service lance le superviseur EN DIRECT (ExecStart) sans
# écrire sup.pid → le test is_alive ci-dessous ne le voit pas, donc sans garde
# le .bashrc lançait un 2e superviseur (doublon observé). La garde
# `systemctl is-active` en tête court-circuite ce cas. Le flock protège en plus
# contre deux appels .bashrc quasi simultanés.

set -euo pipefail

# Source de vérité = le service systemd-user. S'il tourne déjà, ne rien relancer
# (anti-doublon). S'il est absent/mort/désactivé, on poursuit et on prend le
# relais. (Partie gauche d'un && : set -e ne se déclenche pas si is-active != 0.)
systemctl --user is-active --quiet clip-watcher.service 2>/dev/null && exit 0

PID_SUP="$HOME/.clip-watcher.sup.pid"
LOCK="$HOME/.clip-watcher.start.lock"

is_alive() { [[ -f "$1" ]] && kill -0 "$(cat "$1")" 2>/dev/null; }

# Section critique sérialisée par flock (fd 9)
exec 9>"$LOCK"
flock 9

if ! is_alive "$PID_SUP"; then
    nohup "$HOME/.local/bin/clip-watcher-supervisor" >/dev/null 2>&1 &
    echo $! > "$PID_SUP"
fi

flock -u 9
