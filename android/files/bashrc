# ~/.bashrc — Termux, Catppuccin Mocha, mirrors the Windows PowerShell 7
# profile installed by https://github.com/ahmed-mili/windows-pwsh-config
# (UTF-8 console, gradient USER@HOST header, fastfetch splash, fzf bindings,
#  predictions via shell history + Ubuntu-style prompt).

# Skip non-interactive (scripted pipes, scp, sftp, Claude Code subshells).
case $- in
    *i*) ;;
      *) return ;;
esac

# ---- UTF-8 environment for child processes ----
# Termux/Bionic lacks a `locale` command (termux-packages#546), so utilities
# that probe the encoding via `locale charmap` fall back blindly. Setting
# LANG/LC_ALL explicitly avoids that.
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export LESSCHARSET=utf-8

# ---- Anti force-kill : redemarrer sshd + screenshot-watcher si necessaire ----
# Termux:Boot ne tire qu'au boot Android. Si l'app Termux est force-killed
# (HyperOS task manager, swipe-up dans le recent apps, MIUI memory cleanup,
# OOM), les services lances au boot disparaissent et Termux:Boot ne les rejoue
# PAS a la prochaine ouverture de l'app -- la doc Termux:Boot est explicite la
# dessus. Sans ce bloc, le pipeline tel -> PC (img2clip pour screenshots et
# photos, ssh phone pour debug) reste casse jusqu'au prochain reboot Android.
# Idempotent : si deja vivants, no-op.
# Constate 2026-05-28 apres force-stop+relance Termux pour recharger les aliases.
if ! pgrep -x sshd >/dev/null 2>&1; then
    sshd 2>/dev/null
fi
# Le superviseur se protege desormais lui-meme par un verrou flock (cf.
# boot-screenshot-watcher) : on peut donc le (re)lancer inconditionnellement.
# S'il tourne deja, ce lancement sort aussitot en no-op (flock echoue avant tout
# effet de bord). On NE reimplemente PAS de check ici : l'ancien check PID-file
# etait TOCTOU et lancait un 2e superviseur en course avec Termux:Boot -> double
# watcher (constate 2026-05-29).
nohup bash "$HOME/.termux/boot/screenshot-watcher" >/dev/null 2>&1 &
disown

# ---- Editor / pager defaults aligned with the Windows side ----
export EDITOR="${EDITOR:-nano}"
export PAGER="less -R"

# ---- History — large, deduped, shared across panes ----
export HISTSIZE=50000
export HISTFILESIZE=100000
export HISTCONTROL=ignoredups:erasedups
export HISTTIMEFORMAT="%F %T "
shopt -s histappend
shopt -s checkwinsize
shopt -s globstar 2>/dev/null
shopt -s autocd 2>/dev/null
PROMPT_COMMAND="history -a; history -n${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# ---- ls / cat / find replacements when available (eza/bat/fd/ripgrep) ----
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -l --icons --git --group-directories-first'
    alias la='eza -la --icons --git --group-directories-first'
    alias tree='eza --tree --icons --level=3'
else
    alias ls='ls --color=auto'
    alias ll='ls -lh --color=auto'
    alias la='ls -lah --color=auto'
fi
command -v bat       >/dev/null 2>&1 && alias cat='bat --paging=never --style=plain'
# NOTE: do NOT alias grep → rg. Their flags diverge (rg -E = encoding,
# grep -E = extended regex) and it silently breaks shell pipelines + muscle
# memory. Call `rg` directly when you want ripgrep semantics.
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'

# ---- tmux helpers — survive screen-off / app-switch on Android ----
# Android kills background processes aggressively (especially MIUI). Run
# Claude Code inside a tmux session and your work survives across phone
# locks, app switches, and even Termux force-stops as long as Termux
# itself is restarted before the OOM killer reaps the session.
#   tmain        attach the "main" session, creating it if missing
#   tls          list sessions
#   Inside tmux: Ctrl+B then D to detach (session keeps running)
#                Ctrl+B then C to create a new window
#                Ctrl+B then 0/1/2 to switch windows
alias tmain='tmux new-session -A -s main'
alias tls='tmux ls'

# ---- isadmin helper (returns 0 if running as root — root rarely needed on Termux) ----
isadmin() { [ "$(id -u)" -eq 0 ]; }

# ---- Prompt: one-line Ubuntu style — user@host (green) : path (blue) $ (replaces Starship) ----
# Same look as a stock Ubuntu shell (user@HOST:/path$). user@host is built ONCE at shell
# init (real Termux user + getprop model = the same machine name as the splash header), so the
# only per-prompt work is the path. ~ abbreviates $HOME and the full path shows elsewhere.
# Color codes are wrapped in \[ \] so readline measures the visible width correctly.
_PROMPT_ID="${USER:-$(whoami 2>/dev/null || echo termux)}@$(getprop ro.product.model 2>/dev/null || hostname 2>/dev/null || echo termux)"
_set_prompt() {
  # Always the FULL absolute path (no ~ shorthand) so you instantly know where you are.
  PS1="\[\e[1;38;2;166;227;161m\]${_PROMPT_ID}\[\e[0m\]:\[\e[1;38;2;137;180;250m\]${PWD}\[\e[0m\]\$ "
}
PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }_set_prompt"

# ---- fzf — Ctrl+R (history), Ctrl+T (file picker), Alt+C (cd into dir) ----
# Mirrors the PSFzf keybindings on the Windows side.
if command -v fzf >/dev/null 2>&1; then
    # Termux ships fzf without the keybindings shipped on Linux distros, so we
    # source the upstream snippets shipped under share/ when present.
    [ -f "$PREFIX/share/fzf/key-bindings.bash" ] && source "$PREFIX/share/fzf/key-bindings.bash"
    [ -f "$PREFIX/share/fzf/completion.bash"   ] && source "$PREFIX/share/fzf/completion.bash"
    export FZF_DEFAULT_OPTS="
        --height 40% --layout=reverse --border
        --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
        --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
        --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
        --color=selected-bg:#45475a"
    command -v fd >/dev/null 2>&1 && export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
fi

# ---- Start in the phone's shared internal storage (/storage/emulated/0) ----
# That's what Material Files and the default Android file manager open on ("Internal
# storage"), not Termux's sandboxed home. Only when launching at $HOME (a fresh login),
# so it never overrides the directory a subshell was started from. Needs storage access
# (termux-setup-storage); silently stays in $HOME if it's not reachable.
if [ "$PWD" = "$HOME" ] && [ -d /storage/emulated/0 ]; then
    cd /storage/emulated/0 2>/dev/null || true
fi

# ---- Gradient USER@HOST header + fastfetch (interactive shells only) ----
# Renders the same five Catppuccin stops as the Windows splash (Mauve →
# Lavender → Sapphire) so the header is a continuous palette ribbon.
if [ -t 1 ] && command -v fastfetch >/dev/null 2>&1; then
    _gradient_header() {
        # USER is empty in local Termux and hostname is "localhost" -> ugly "@localhost".
        # Build a clean, fully DYNAMIC USER@MACHINE label (nothing hardcoded, so the repo
        # stays shareable): the real Termux user ($USER, or `whoami` fallback since $USER
        # is empty in local Termux) @ the device model from getprop (ro.product.model,
        # e.g. 23078PND5G — the truest parallel to a PC hostname); falls back to
        # hostname/termux off-Android.
        local text="${USER:-$(whoami 2>/dev/null || echo termux)}@$(getprop ro.product.model 2>/dev/null || hostname 2>/dev/null || echo termux)"
        local n=${#text}
        # Three RGB stops: Mauve→Lavender, Lavender, Lavender→Sapphire.
        local r=(192 180 148)
        local g=(178 190 194)
        local b=(250 254 245)
        local seg_count=2
        local out=""
        local i u seg t ra ga ba rb gb bb rr gg bbv ch
        for (( i=0; i<n; i++ )); do
            if (( n > 1 )); then
                u=$(awk -v i="$i" -v n="$n" -v s="$seg_count" 'BEGIN { printf "%.6f", (i/(n-1))*s }')
            else
                u=0
            fi
            seg=${u%.*}
            (( seg >= seg_count )) && seg=$((seg_count - 1))
            t=$(awk -v u="$u" -v seg="$seg" 'BEGIN { printf "%.6f", u-seg }')
            ra=${r[$seg]}; ga=${g[$seg]}; ba=${b[$seg]}
            rb=${r[$((seg+1))]}; gb=${g[$((seg+1))]}; bb=${b[$((seg+1))]}
            rr=$(awk -v a="$ra" -v b="$rb" -v t="$t" 'BEGIN { printf "%d", a+(b-a)*t+0.5 }')
            gg=$(awk -v a="$ga" -v b="$gb" -v t="$t" 'BEGIN { printf "%d", a+(b-a)*t+0.5 }')
            bbv=$(awk -v a="$ba" -v b="$bb" -v t="$t" 'BEGIN { printf "%d", a+(b-a)*t+0.5 }')
            ch="${text:$i:1}"
            out+=$'\033'"[1;38;2;${rr};${gg};${bbv}m${ch}"
        done
        printf '\n%s\033[0m\n' "$out"
    }
    _gradient_header
    fastfetch
fi

# ---- Termux-specific: refresh PATH for ~/.local/bin and npm-global ----
export PATH="$HOME/.local/bin:$PREFIX/lib/node_modules/.bin:$PATH"

# ---- Desktop connection (Tailscale, host alias `desktop` in ~/.ssh/config) ----
#
# Desktop access now goes through native Windows PowerShell only:
#   pwsh/pwshm : same perimeter as F2 on the PC: active Zellij sessions,
#                C:\dev projects, and Obsidian vaults. The list is generated by
#                the Windows sessionizer, then opened through the Termux-local
#                Zellij web client/tunnel so sessions stay desktop-native.
#   sleep-pc   : suspend the desktop (sleep).   stop-pc : full shutdown.
#                Both go through the Windows sshd (port 2222) + $WIN_USER, so native
#                commands run.
#
# Retire previous desktop helpers even in already-open shells that source this file.
unalias wsl wslm dev devm 2>/dev/null || true
unset -f wsl wslm dev devm 2>/dev/null || true

# pwsh/pwshm use the Windows sessionizer over sshd :2222.
# Functions (not aliases) avoid clashing with remote pwsh.
# Projets ET vaults passent par le web server zellij du bureau : une session
# creee via lui nait dans la logon session interactive (Session 1) et reste
# joignable depuis le bureau (F2). L'ancien chemin direct (`zellij attach -c`
# dans le contexte sshd) creait des sessions Session 0 fantomes, invisibles et
# injoignables du bureau (bug du 2026-06-12) -- supprime. Le cwd est applique
# par le bloc ZELLIJ_SESSION_NAME du profil pwsh bureau.
_pc_require_win_user() {
  [ -n "${WIN_USER:-}" ] || { echo "set WIN_USER in ~/.bashrc.local to reach the Windows desktop" >&2; return 1; }
}
_pc_ssh_port() {
  printf '%s' "${PC_DESKTOP_SSH_PORT:-2222}"
}
_pc_explain_ssh_failure() {
  local rc="$1"
  local err_file="$2"
  local what="${3:-joindre le PC}"
  local port msg last
  port="$(_pc_ssh_port)"
  msg="$(tr -d '\r' < "$err_file" 2>/dev/null || true)"
  last="$(printf '%s\n' "$msg" | sed '/^[[:space:]]*$/d' | tail -n 1)"
  case "$msg" in
    *"Connection timed out"*|*"Operation timed out"*|*"No route to host"*|*"Network is unreachable"*|*"Could not resolve hostname"*|*"Name or service not known"*|*"Temporary failure in name resolution"*)
      printf '\033[33mPC injoignable via Tailscale pendant: %s.\033[0m\n' "$what" >&2
      printf 'Sur le telephone: ouvre Tailscale, puis Deconnecter/Reconnecter. Si ca persiste, redemarre Tailscale sur le PC et relance pwsh.\n' >&2
      ;;
    *"Connection refused"*)
      printf '\033[33mLe PC repond, mais sshd Windows (:%s) refuse la connexion.\033[0m\n' "$port" >&2
      printf 'Au PC: relance OpenSSH Server, par exemple dans PowerShell admin: Restart-Service sshd\n' >&2
      ;;
    *"Permission denied"*)
      printf '\033[33mLe PC est joignable, mais SSH refuse l authentification.\033[0m\n' >&2
      printf 'Verifie WIN_USER dans ~/.bashrc.local et la cle publique autorisee cote Windows.\n' >&2
      ;;
    *"REMOTE HOST IDENTIFICATION HAS CHANGED"*|*"Host key verification failed"*)
      printf '\033[33mLa cle SSH du PC a change.\033[0m\n' >&2
      printf 'Verifie que tu joins le bon PC, puis nettoie l ancienne entree dans ~/.ssh/known_hosts.\n' >&2
      ;;
    *"kex_exchange_identification"*|*"Connection reset"*|*"Connection closed"*)
      printf '\033[33mLa connexion au PC a ete coupee pendant: %s.\033[0m\n' "$what" >&2
      printf 'Souvent c est Tailscale ou sshd qui vient de tomber: reconnecte Tailscale telephone/PC, puis relance pwsh.\n' >&2
      ;;
    *)
      if [ "$rc" -eq 255 ]; then
        printf '\033[33mImpossible de %s via desktop:%s.\033[0m\n' "$what" "$port" >&2
        printf 'Si Tailscale etait en veille: ouvre Tailscale sur le telephone, Deconnecter/Reconnecter, puis relance pwsh.\n' >&2
      else
        printf '\033[33mLa commande PC a echoue pendant: %s.\033[0m\n' "$what" >&2
      fi
      ;;
  esac
  [ -n "$last" ] && printf '\033[2mssh: %s\033[0m\n' "$last" >&2
}
_pc_ssh_win() {
  local what="$1"
  shift
  _pc_require_win_user || return 1
  local err_file rc port
  port="$(_pc_ssh_port)"
  err_file="$(mktemp "${TMPDIR:-/tmp}/pc-ssh.XXXXXX")" || return 1
  ssh -o "ConnectTimeout=${PC_SSH_TIMEOUT:-8}" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR \
    -p "$port" "${WIN_USER}@desktop" "$@" </dev/null 2>"$err_file"
  rc=$?
  if [ "$rc" -eq 255 ]; then
    _pc_explain_ssh_failure "$rc" "$err_file" "$what"
  elif [ "$rc" -ne 0 ] && [ -s "$err_file" ]; then
    _pc_explain_ssh_failure "$rc" "$err_file" "$what"
  fi
  rm -f "$err_file"
  return "$rc"
}
_pc_label_for_kind() {
  case "$1" in
    project) printf 'project' ;;
    vault)   printf 'vault' ;;
    new)     printf 'session' ;;
    *)       printf 'session' ;;
  esac
}
_pc_open_native_session() {
  local name="$1"
  local kind="${2:-active}"
  local label
  label="$(_pc_label_for_kind "$kind")"
  [ -n "$name" ] || return 0
  _pc_require_win_user || return 1
  command -v zellij >/dev/null 2>&1 || { echo "install Termux zellij first: pkg install zellij" >&2; return 1; }
  local token_file="${PC_ZELLIJ_WEB_TOKEN_FILE:-$HOME/.config/pc-zellij-web-token}"
  [ -r "$token_file" ] || { echo "missing Zellij web token: $token_file" >&2; return 1; }
  local token; token="$(tr -d '\r\n' < "$token_file")"
  [ -n "$token" ] || { echo "empty Zellij web token: $token_file" >&2; return 1; }
  local local_port="${PC_ZELLIJ_WEB_LOCAL_PORT:-$((18082 + (RANDOM % 1000)))}"
  local remote_port="${PC_ZELLIJ_WEB_REMOTE_PORT:-8082}"
  clear 2>/dev/null
  printf '\033[2m→ opening %s %s…\033[0m\n' "$label" "$name"   # feedback while the ssh connects
  # Open in NATIVE Windows pwsh through Zellij web, tunneled over the Windows sshd
  # (port 2222). A direct `zellij attach` inside sshd is not truly persistent on
  # Windows: each OpenSSH reconnect can get a different IPC/window-station scope,
  # so Zellij may resurrect metadata into a fresh shell instead of reattaching the
  # live pane. The web server is TCP + token based, so a new tunnel can reattach
  # the same live Windows session after Wi-Fi/5G changes.
  # ConnectTimeout=8 : si le sshd Windows (:2222) est down, on echoue vite (~8s) avec un
  # message clair, au lieu de figer sur « opening vault… » (sans ConnectTimeout, ssh pend
  # ~2min sur le timeout TCP par defaut). ssh renvoie 255 sur ECHEC DE CONNEXION
  # uniquement (une sortie normale de pwsh/claude renvoie son propre code, pas 255).
  # Verifie que le web server zellij ecoute COTE BUREAU (tache planifiee
  # zellij-web-server au logon, ou secours du profil pwsh). On ne lance meme
  # pas `zellij web --status` d'ici : depuis sshd, tout appel zellij risque de
  # naitre/tenir un handle en Session 0 et de rendre les sessions injoignables
  # depuis le bureau (bug 2026-06-12).
  _pc_ssh_win "tester Zellij web sur le PC" \
    "pwsh -NoProfile -NoLogo -Command \"\$tcp = [Net.Sockets.TcpClient]::new(); try { \$tcp.Connect('127.0.0.1', $remote_port); exit 0 } catch { exit 9 } finally { \$tcp.Dispose() }\""
  local pre_rc=$?
  if [ "$pre_rc" -eq 255 ]; then
    return 255
  fi
  if [ "$pre_rc" -ne 0 ]; then
    printf '\033[33mZellij web est offline sur le PC.\033[0m\n' >&2
    printf 'Ouvre une session Windows sur le bureau, ou relance la tache zellij-web-server, puis retape pwsh.\n' >&2
    return 1
  fi

  local had_monitor=0
  case $- in *m*) had_monitor=1; set +m ;; esac
  local tunnel_pid tunnel_err port
  port="$(_pc_ssh_port)"
  tunnel_err="$(mktemp "${TMPDIR:-/tmp}/pc-zellij-tunnel.XXXXXX")" || return 1
  {
    ssh -N -L "127.0.0.1:${local_port}:127.0.0.1:${remote_port}" \
      -o ExitOnForwardFailure=yes -o "ConnectTimeout=${PC_SSH_TIMEOUT:-8}" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR \
      -p "$port" "${WIN_USER}@desktop" 2>"$tunnel_err" &
    tunnel_pid=$!
  }
  sleep 0.6
  if ! kill -0 "$tunnel_pid" >/dev/null 2>&1; then
    wait "$tunnel_pid" 2>/dev/null
    local tunnel_rc=$?
    [ "$had_monitor" -eq 1 ] && set -m
    if grep -qi 'address already in use' "$tunnel_err" 2>/dev/null; then
      printf '\033[33mLe port local %s est deja occupe.\033[0m\n' "$local_port" >&2
      printf 'Relance pwsh pour prendre un autre port, ou change PC_ZELLIJ_WEB_LOCAL_PORT.\n' >&2
    else
      _pc_explain_ssh_failure "$tunnel_rc" "$tunnel_err" "ouvrir le tunnel Zellij web"
    fi
    rm -f "$tunnel_err"
    return 1
  fi
  zellij attach "http://127.0.0.1:${local_port}/$name" --token "$token"
  local rc=$?
  kill "$tunnel_pid" >/dev/null 2>&1 || true
  wait "$tunnel_pid" 2>/dev/null || true
  rm -f "$tunnel_err"
  [ "$had_monitor" -eq 1 ] && set -m
  return "$rc"
}
_pc_pick_native() {
  local view="${1:-all}"
  local prompt="${2:-pc ❯ }"
  _pc_require_win_user || return 1
  command -v fzf >/dev/null 2>&1 || { echo "install fzf first: pkg install fzf" >&2; return 1; }
  local sessionizer_win="${PC_SESSIONIZER_WIN:-C:\\dev\\dev-environment\\claude-code\\windows-sessionizer\\sessionizer.ps1}"
  local rows out key choice kind name cursor0 seps refresh_script rows_cache listen_sock refresh_pid refresh_sec pos_flag
  rows=$(_pc_ssh_win "lister le sessionizer du PC" \
    "pwsh -NoProfile -NoLogo -ExecutionPolicy Bypass -File \"$sessionizer_win\" -List -View \"$view\"") || return $?
  [ -n "$rows" ] || { echo "sessionizer PC vide: aucun projet, vault ou session active trouve" >&2; return 1; }
  rows_cache="$(mktemp "${TMPDIR:-/tmp}/pc-sessionizer-rows.XXXXXX")" || return 1
  refresh_script="$(mktemp "${TMPDIR:-/tmp}/pc-sessionizer-refresh.XXXXXX")" || { rm -f "$rows_cache"; return 1; }
  listen_sock="${TMPDIR:-/tmp}/pc-sessionizer-fzf.$$.sock"
  printf '%s\n' "$rows" > "$rows_cache"
  {
    printf '%s\n' '#!/usr/bin/env bash'
    printf '%s\n' 'set -u'
    printf 'rows_cache=%q\n' "$rows_cache"
    printf 'sessionizer_win=%q\n' "$sessionizer_win"
    printf 'view=%q\n' "$view"
    printf '%s\n' '[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local" >/dev/null 2>&1 || true'
    printf '%s\n' 'port="${PC_DESKTOP_SSH_PORT:-2222}"'
    printf '%s\n' 'tmp="$(mktemp "${TMPDIR:-/tmp}/pc-sessionizer-rows-new.XXXXXX")" || { cat "$rows_cache" 2>/dev/null; exit 0; }'
    printf '%s\n' 'if [ -n "${WIN_USER:-}" ] && ssh -o "ConnectTimeout=${PC_SSH_TIMEOUT:-8}" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR -p "$port" "${WIN_USER}@desktop" "pwsh -NoProfile -NoLogo -ExecutionPolicy Bypass -File \"$sessionizer_win\" -List -View \"$view\"" </dev/null >"$tmp" 2>/dev/null && [ -s "$tmp" ]; then'
    printf '%s\n' '  mv "$tmp" "$rows_cache"'
    printf '%s\n' 'else'
    printf '%s\n' '  rm -f "$tmp"'
    printf '%s\n' 'fi'
    printf '%s\n' 'cat "$rows_cache" 2>/dev/null'
  } > "$refresh_script"
  chmod 700 "$refresh_script"
  pos_flag="${TMPDIR:-/tmp}/pc-sessionizer-pos.$$"
  while true; do
    # fzf starts on the first real item, not on decorative section titles.
    # The pos() must fire on the FIRST load only: fzf re-emits `load` after every
    # periodic reload(), and an unconditional load:pos() would snap the cursor
    # back to the first item every PC_SESSIONIZER_REFRESH_SEC seconds while the
    # user navigates. --track keeps the cursor on its item across reloads.
    rm -f "$pos_flag"
    cursor0=$(printf '%s\n' "$rows" | awk -F '\t' '$1 != "sep" { print NR; exit } END { if (NR == 0) print 1 }')
    [ -n "$cursor0" ] || cursor0=1
    seps=$(printf '%s\n' "$rows" | awk -F '\t' '$1 == "sep" { printf " %d", NR }')
    refresh_pid=''
    if command -v curl >/dev/null 2>&1; then
      refresh_sec="${PC_SESSIONIZER_REFRESH_SEC:-2}"
      (
        while [ ! -S "$listen_sock" ]; do sleep 0.1; done
        while [ -S "$listen_sock" ]; do
          sleep "$refresh_sec"
          [ -S "$listen_sock" ] || break
          curl --silent --show-error --max-time 2 --unix-socket "$listen_sock" \
            -XPOST http://localhost -d "reload($refresh_script)" >/dev/null 2>&1 || true
        done
      ) &
      refresh_pid=$!
    fi
    out=$(printf '%s\n' "$rows" | fzf \
      --ansi --delimiter=$'\t' --with-nth=3 --layout=reverse --no-multi \
      --track --id-nth=2 \
      --border=rounded --border-label=' ◆ Sessionizer ' --border-label-pos=3 \
      --padding=0,1 --info=hidden --ellipsis='…' \
      --color=pointer:141,bg+:237,fg+:255,hl:141,hl+:141,header:245,prompt:108,border:240,label:141,gutter:-1 \
      --prompt="$prompt" --header='F2 scope - auto-refresh - Enter open - Ctrl+N new - Esc cancel' \
      --expect=ctrl-n \
      --listen="$listen_sock" \
      --bind "load:transform:[ -e '$pos_flag' ] || { touch '$pos_flag'; echo 'pos($cursor0)'; }" \
      --bind "down:transform:[ -z {q} ] || { echo down; exit 0; }; n=\$((FZF_POS+1)); case \" $seps \" in *\" \$n \"*) echo down+down;; *) echo down;; esac" \
      --bind "up:transform:[ -z {q} ] || { echo up; exit 0; }; p=\$((FZF_POS-1)); case \" $seps \" in *\" \$p \"*) [ \$p -eq 1 ] && echo ignore || echo up+up;; *) echo up;; esac" \
      --bind "left-click:transform:[ -n {q} ] && echo ignore || { case \" $seps \" in *\" \$FZF_POS \"*) echo down;; *) echo ignore;; esac; }" \
      --bind "double-click:transform:[ -n {q} ] && echo accept || { case \" $seps \" in *\" \$FZF_POS \"*) echo down;; *) echo accept;; esac; }")
    local fzf_rc=$?
    [ -n "$refresh_pid" ] && kill "$refresh_pid" >/dev/null 2>&1 || true
    wait "$refresh_pid" 2>/dev/null || true
    rm -f "$listen_sock"
    rows="$(cat "$rows_cache" 2>/dev/null || printf '%s\n' "$rows")"
    [ "$fzf_rc" -ne 0 ] && { rm -f "$refresh_script" "$rows_cache" "$pos_flag"; return 0; }
    key=$(printf '%s\n' "$out" | sed -n '1p')
    choice=$(printf '%s\n' "$out" | sed -n '2p')
    if [ "$key" = "ctrl-n" ]; then
      printf 'Session name: ' >&2
      IFS= read -r name
      [ -n "$name" ] && _pc_open_native_session "$name" new
      rm -f "$refresh_script" "$rows_cache" "$pos_flag"
      return $?
    fi
    [ -n "$choice" ] || { rm -f "$refresh_script" "$rows_cache" "$pos_flag"; return 0; }
    kind=$(printf '%s' "$choice" | cut -f1)
    name=$(printf '%s' "$choice" | cut -f2)
    [ "$kind" = "sep" ] && continue
    case "$kind" in
      active|project|vault) _pc_open_native_session "$name" "$kind"; local open_rc=$?; rm -f "$refresh_script" "$rows_cache" "$pos_flag"; return "$open_rc" ;;
      *) echo "sessionizer: choix inconnu: $kind" >&2; rm -f "$refresh_script" "$rows_cache" "$pos_flag"; return 1 ;;
    esac
  done
}
# LogLevel=ERROR: silences « Connection to desktop closed. » + the post-quantum WARNING
# (INFO-level ssh messages) — without hiding real errors (auth, unreachable host).
pwsh()  { _pc_pick_native all 'pc ❯ '; }
pwshm() { pwsh "$@"; }
# Power control of the desktop, through the WINDOWS sshd (port 2222) so native commands run.
# Needs $WIN_USER (~/.bashrc.local), like vaults.
_win_run() {
  _pc_ssh_win "executer une commande Windows" "$@"
}
sleep-pc() { _win_run "rundll32.exe powrprof.dll,SetSuspendState 0,1,0"; }   # suspend (sleep)
stop-pc()  { _win_run "shutdown /s /t 0"; }                                  # full shutdown

# ---- Ollama Cloud model launcher (Ctrl+Y sur le desktop, ou `oc` depuis le tél) ----
oc() { ssh -tt -o LogLevel=ERROR desktop "$HOME/dev/dev-environment/claude-code/ollama-launcher.sh"; }

# ---- Claude Code wrapper : truecolor + device-context detection ------------
# Claude Code downgrades to 256-color when it sees $TMUX -> launch without.
# Termux: device-context detector writes ~/.claude/.device-context so the
# assistant knows which machine/shell/context it is talking to.
claude() {
  if [ -f "$HOME/.claude/device-context/detect.sh" ]; then
    bash "$HOME/.claude/device-context/detect.sh" 2>/dev/null || true
  fi
  env -u TMUX claude "$@"
}

# ---- Local overrides — keep machine-specific tweaks out of git ----
[ -f "$HOME/.bashrc.local" ] && source "$HOME/.bashrc.local"
